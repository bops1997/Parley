{
    "manifest_version": 3,
    "name": "Parley",
    "version": "1.0.0",
    "description": "The voice assistant you talk with — dictate, rewrite, and talk back on any page.",
    "action": {
      "default_title": "Parley",
      "default_popup": "popup.html",
      "default_icon": { "128": "icon128.png" }
    },
    "icons": { "128": "icon128.png" },
    "permissions": ["activeTab", "scripting", "storage"],
    "host_permissions": ["http://localhost:4141/*"],
    "content_scripts": [
      { "matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }
    ]
  }