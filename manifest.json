{
    "manifest_version": 3,
    "name": "Parley",
    "version": "1.2.5",
    "description": "The voice assistant you talk with — dictate, rewrite, and talk back on any page.",
    "background": { "service_worker": "background.js" },
    "action": {
      "default_title": "Parley",
      "default_popup": "popup.html",
      "default_icon": { "128": "icon128.png" }
    },
    "icons": { "128": "icon128.png" },
    "permissions": ["activeTab", "scripting", "storage", "tabs"],
    "host_permissions": ["http://*/*", "https://*/*", "http://localhost:4141/*"],
    "web_accessible_resources": [{ "resources": ["icon128.png", "wake-bridge.js"], "matches": ["<all_urls>"] }],
    "content_scripts": [
      { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }
    ]
  }